# Port to expose the web GUI on
PORT=8080

# Address the port is published on.
#   127.0.0.1 (default) - only reachable from this machine
#   0.0.0.0             - reachable from your whole network
# The app has NO login. Only use 0.0.0.0 on a network you fully trust, or put
# a reverse proxy with authentication / a VPN in front of it.
BIND_ADDRESS=127.0.0.1

# REQUIRED: Flask secret key. The container will not start without it.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# IANA timezone used to display times and to interpret cron schedules
# (e.g. America/New_York, Europe/London). Defaults to UTC.
TIMEZONE=UTC

# Optional: comma-separated host:port values the app answers to, as typed in the
# browser's address bar. Setting this blocks DNS rebinding attacks.
#ALLOWED_HOSTS=127.0.0.1:8080,nas.lan:8080

# Path to your rclone config directory
RCLONE_CONFIG=~/.config/rclone

# Host path containing the data to back up. It is mounted READ-WRITE at /mnt/
# inside the container.
DATA_PATH=/mnt/storage
