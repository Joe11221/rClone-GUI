# Port to expose the web GUI on
PORT=8080

# Address the port is published on.
#   127.0.0.1 (default) - only reachable from this machine
#   0.0.0.0             - reachable from your whole network
# The app asks you to set a password on first visit (see AUTH_MODE below).
# Even so, prefer a VPN or an https reverse proxy over exposing the port directly.
BIND_ADDRESS=127.0.0.1

# Optional: Flask secret key, used to sign login sessions. Leave empty and one
# is generated on first start and saved in ./data (the instance folder), then
# reused. Do not use placeholder values like "change-me": the app refuses them.
# To choose your own:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# How people log in:
#   password (default) - set a single password on your first visit
#   proxy              - a reverse proxy (Authelia, Authentik, oauth2-proxy)
#                        logs users in and sends the AUTH_PROXY_HEADER header;
#                        requests without it get 401. The app's port must then
#                        be reachable ONLY by that proxy, or the header can be forged.
#   none               - no login. Anyone who can reach the page controls your backups.
AUTH_MODE=password
#AUTH_PROXY_HEADER=Remote-User

# Set to true only when the app is served over https, so the login cookie is
# never sent over plain http.
SECURE_COOKIES=false

# IANA timezone used to display times and to interpret cron schedules
# (e.g. America/New_York, Europe/London). Defaults to UTC.
TIMEZONE=UTC

# Optional: comma-separated host:port values the app answers to, as typed in the
# browser's address bar. Setting this blocks DNS rebinding attacks.
#ALLOWED_HOSTS=127.0.0.1:8080,nas.lan:8080

# Path to your rclone config directory
RCLONE_CONFIG=~/.config/rclone

# Host path containing the data to back up. It is mounted READ-WRITE at /mnt/
# inside the container.
DATA_PATH=/mnt/storage
